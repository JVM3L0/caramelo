# Copy to .env and adjust. Everything is optional for local development.

# Outside compose, point at the db container's published port.
CARAMELO_DATABASE_URL=postgresql://caramelo:caramelo@localhost:5432/caramelo

# Route store traffic through a proxy (off by default).
# CARAMELO_HTTP_PROXY=http://user:pass@host:port

# Pluggable implementations (only these exist for now).
# CARAMELO_AFFILIATE_LINKER=passthrough
# CARAMELO_COPYWRITER=template
